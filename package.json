{
  "name": "nayepankh-vms",
  "version": "1.0.0",
  "description": "NayePankh Volunteer Management System Root",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start": "npm start --prefix server",
    "install-server": "npm install --prefix server",
    "install-client": "npm install --include=dev --prefix client",
    "build-client": "npm run build --prefix client",
    "build": "npm run install-server && npm run install-client && npm run build-client",
    "dev": "npm run dev --prefix server & npm run dev --prefix client"
  },
